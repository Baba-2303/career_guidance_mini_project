# Copy this file to secrets.toml (same folder) and fill in real values.
# secrets.toml is gitignored — never commit it.

# Required for AI messages. Free key: https://console.groq.com → API Keys
GROQ_API_KEY = "<PASTE_GROQ_KEY>"
GROQ_MODEL = "openai/gpt-oss-120b"

# Optional: protects the Survey Summary page. Leave out to keep it open (fine on a laptop).
SUMMARY_PASSWORD = "<CHOOSE_A_PASSWORD>"

# Optional: online database (needed only when hosted). Leave out to save to data/responses.csv.
SUPABASE_URL = "https://<PROJECT_REF>.supabase.co"
SUPABASE_KEY = "<SUPABASE_SECRET_KEY>"
